<Window Icon="/IvySay;component/IvySay.ico" x:Class="IvySay.HistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:IvySay" Cursor="{x:Static local:AppCursors.Arrow}" Title="Ivy Say · Dictation history" Width="690" Height="700" MinWidth="500" MinHeight="500" WindowStartupLocation="CenterScreen" Background="#f5f7f2" FontFamily="Segoe UI">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="140"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Dictation history" FontSize="23" FontWeight="SemiBold" Foreground="#202a28"/>
    <TextBlock x:Name="Status" Grid.Row="1" Text="Stored encrypted on this device." TextWrapping="Wrap" Foreground="#65746c" Margin="0,8,0,10"/>
    <ListBox x:Name="Entries" Grid.Row="2" SelectionChanged="SelectionChanged" DisplayMemberPath="Label"/>
    <TextBlock Grid.Row="3" Text="Whisper transcript" FontWeight="SemiBold" Margin="0,10,0,4"/>
    <TextBox x:Name="Raw" Grid.Row="4" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8"/>
    <TextBlock Grid.Row="5" Text="Inserted text" FontWeight="SemiBold" Margin="0,10,0,4"/>
    <TextBox x:Name="Result" Grid.Row="6" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8"/>
    <WrapPanel Grid.Row="7" Margin="0,12,0,0"><Button x:Name="Play" Content="Play audio" Click="PlayAudio" IsEnabled="False"/><Button Content="Stop" Click="StopAudio" Margin="8,0,0,0"/><Button x:Name="Delete" Content="Delete selected" Click="DeleteSelected" Margin="8,0,0,0" IsEnabled="False"/><Button Content="Delete all audio" Click="DeleteAudio" Margin="8,0,0,0"/><Button Content="Delete all history" Click="DeleteAll" Margin="8,0,0,0"/></WrapPanel>
    <Button Grid.Row="8" Content="Close" Click="CloseWindow" HorizontalAlignment="Right" Margin="0,12,0,0"/>
  </Grid>
</Window>
