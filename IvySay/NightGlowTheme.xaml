<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <LinearGradientBrush x:Key="Frosted" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#252834"/><GradientStop Color="#1B1D26" Offset="0.55"/><GradientStop Color="#14161D" Offset="1"/></LinearGradientBrush>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#F4F6FA"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#C4CAD8"/><Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#161820"/><Setter Property="BorderBrush" Value="#2A2D3A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="18,0"/><Setter Property="Foreground" Value="#F4F6FA"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="{StaticResource Frosted}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="#505A7C" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A5B4FC"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#B8C8FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0F1118"/><Setter Property="Foreground" Value="#F4F6FA"/><Setter Property="CaretBrush" Value="#F4F6FA"/><Setter Property="BorderBrush" Value="#2D3142"/><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="38"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0F1118"/><Setter Property="Foreground" Value="#F4F6FA"/><Setter Property="CaretBrush" Value="#F4F6FA"/><Setter Property="BorderBrush" Value="#2D3142"/><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="40"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F4F6FA"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="18" Height="18" Background="#11131B" BorderBrush="#555E77" BorderThickness="1" CornerRadius="5" Margin="0,0,9,0"><Path x:Name="Tick" Data="M 2,6.5 L 5.2,9.5 L 11,3" Stroke="#F4F6FA" StrokeThickness="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#526BCC"/><Setter TargetName="Box" Property="BorderBrush" Value="#A5B4FC"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F4F6FA"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#242838"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#303952"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox">
    <Setter Property="Height" Value="44"/><Setter Property="Foreground" Value="#F4F6FA"/><Setter Property="FontSize" Value="13.5"/><Setter Property="MaxDropDownHeight" Value="300"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform x:Name="Scale"/></Grid.RenderTransform>
        <Border CornerRadius="12" BorderThickness="2" BorderBrush="#5B7BFF" Opacity="0.18" IsHitTestVisible="False"><Border.Effect><BlurEffect Radius="14"/></Border.Effect></Border>
        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{StaticResource Frosted}" BorderBrush="#2D3142" BorderThickness="1" CornerRadius="12"><Grid><Border Height="1" VerticalAlignment="Top" Margin="12,0" Background="#14FFFFFF"/><Path x:Name="Chevron" Data="M 1,1 L 5.5,5.5 L 10,1" Stroke="#B8C4E0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform x:Name="Arrow"/></Path.RenderTransform></Path></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
        <Border x:Name="Bloom" CornerRadius="12" BorderThickness="2.5" Opacity="0" IsHitTestVisible="False"><Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><LinearGradientBrush.RelativeTransform><RotateTransform x:Name="BloomRotate" CenterX="0.5" CenterY="0.5"/></LinearGradientBrush.RelativeTransform><GradientStop Color="#005B7BFF"/><GradientStop Color="#BB7C9BFF" Offset="0.44"/><GradientStop Color="White" Offset="0.5"/><GradientStop Color="#BB7C9BFF" Offset="0.56"/><GradientStop Color="#005B7BFF" Offset="1"/></LinearGradientBrush></Border.BorderBrush><Border.Effect><BlurEffect Radius="14"/></Border.Effect></Border>
        <Border x:Name="Rim" CornerRadius="12" BorderThickness="1.5" Opacity="0" IsHitTestVisible="False"><Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><LinearGradientBrush.RelativeTransform><RotateTransform x:Name="RimRotate" CenterX="0.5" CenterY="0.5"/></LinearGradientBrush.RelativeTransform><GradientStop Color="#00FFFFFF"/><GradientStop Color="#99A5B4FC" Offset="0.45"/><GradientStop Color="White" Offset="0.5"/><GradientStop Color="#99A5B4FC" Offset="0.55"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.BorderBrush></Border>
        <ContentPresenter Margin="14,0,36,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="6" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="#14161E" BorderBrush="#6D7CAF" BorderThickness="1" CornerRadius="12" Padding="4"><Border.Effect><DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="5" Opacity="0.65"/></Border.Effect><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="BloomRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3.2" RepeatBehavior="Forever"/><DoubleAnimation Storyboard.TargetName="RimRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3.2" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></EventTrigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bloom" Property="Opacity" Value="0.95"/><Setter TargetName="Rim" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Bloom" Property="Opacity" Value="0.95"/><Setter TargetName="Rim" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Bloom" Property="Opacity" Value="0.95"/><Setter TargetName="Rim" Property="Opacity" Value="1"/></Trigger>
        <Trigger SourceName="Toggle" Property="IsPressed" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.988" Duration="0:0:0.09"/><DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.988" Duration="0:0:0.09"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.09"/><DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.09"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border HorizontalAlignment="Left" Background="#090A0E" BorderBrush="#2A2D3A" BorderThickness="1" CornerRadius="12" Padding="4"><TabPanel IsItemsHost="True"/></Border><ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#9CA3B5"/><Setter Property="Padding" Value="16,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="#252834"/><Setter Property="Foreground" Value="#F4F6FA"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#A5B4FC"/><Setter TargetName="Tab" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
