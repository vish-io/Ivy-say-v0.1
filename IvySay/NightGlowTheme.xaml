<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:IvySay">
  <!-- Quiet full-window glow and technical grid, deliberately behind all controls. -->
  <DrawingBrush x:Key="SettingsBackdrop" Viewbox="0,0,100,100" ViewboxUnits="Absolute" Stretch="Fill">
    <DrawingBrush.Drawing><DrawingGroup>
      <GeometryDrawing Brush="#0B1014" Geometry="M0,0 H100 V100 H0 Z"/>
      <GeometryDrawing Geometry="M0,0 H100 V100 H0 Z"><GeometryDrawing.Brush><RadialGradientBrush Center="0.8,0.15" GradientOrigin="0.8,0.15" RadiusX="0.8" RadiusY="0.7"><GradientStop Color="#66356553"/><GradientStop Color="#1D204C3B" Offset="0.45"/><GradientStop Color="#000B1014" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
      <GeometryDrawing Geometry="M0,0 H100 V100 H0 Z"><GeometryDrawing.Brush><RadialGradientBrush Center="0.08,0.94" GradientOrigin="0.08,0.94" RadiusX="0.6" RadiusY="0.6"><GradientStop Color="#45266B5B"/><GradientStop Color="#000B1014" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
      <GeometryDrawing Geometry="M0,0 H100 V100 H0 Z"><GeometryDrawing.Brush><DrawingBrush TileMode="Tile" Viewport="0,0,5,5" ViewportUnits="Absolute" Viewbox="0,0,5,5" ViewboxUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Geometry="M0,5 L0,0 L5,0"><GeometryDrawing.Pen><Pen Brush="#183C8A73" Thickness="0.08"/></GeometryDrawing.Pen></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush></GeometryDrawing.Brush></GeometryDrawing>
      <GeometryDrawing Geometry="M-15,100 C3,50 18,16 54,-12"><GeometryDrawing.Pen><Pen Brush="#163AA47E" Thickness="0.25"/></GeometryDrawing.Pen></GeometryDrawing>
      <GeometryDrawing Geometry="M-5,110 C15,60 29,24 67,-12"><GeometryDrawing.Pen><Pen Brush="#103AA47E" Thickness="0.18"/></GeometryDrawing.Pen></GeometryDrawing>
    </DrawingGroup></DrawingBrush.Drawing>
  </DrawingBrush>
  <LinearGradientBrush x:Key="Frosted" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#252834"/><GradientStop Color="#1B1D26" Offset="0.55"/><GradientStop Color="#14161D" Offset="1"/></LinearGradientBrush>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="#F4F6FA"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#C4CAD8"/><Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
  <!-- Green glass field inspired by Peak Chart by Louis Studios; implemented with native WPF brushes. -->
  <DrawingBrush x:Key="GreenCardBrush" Viewbox="0,0,100,100" ViewboxUnits="Absolute" Stretch="Fill">
    <DrawingBrush.Drawing><DrawingGroup>
      <GeometryDrawing Brush="#080F10" Geometry="M0,0 H100 V100 H0 Z"/>
      <GeometryDrawing Geometry="M0,0 H100 V100 H0 Z"><GeometryDrawing.Brush><RadialGradientBrush Center="0.83,0.03" GradientOrigin="0.83,0.03" RadiusX="0.82" RadiusY="0.72"><GradientStop Color="#993B9E81" Offset="0"/><GradientStop Color="#4D126654" Offset="0.36"/><GradientStop Color="#0010342C" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
      <GeometryDrawing Geometry="M0,0 H100 V100 H0 Z"><GeometryDrawing.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00031815" Offset="0"/><GradientStop Color="#00031815" Offset="0.75"/><GradientStop Color="#3032A98D" Offset="0.91"/><GradientStop Color="#8856DBC0" Offset="0.975"/><GradientStop Color="#D0BBFFE8" Offset="1"/></LinearGradientBrush></GeometryDrawing.Brush></GeometryDrawing>
    </DrawingGroup></DrawingBrush.Drawing>
  </DrawingBrush>
  <LinearGradientBrush x:Key="GreenCardRim" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#6659AD98" Offset="0"/><GradientStop Color="#35307264" Offset="0.56"/><GradientStop Color="#A567D9BA" Offset="1"/></LinearGradientBrush>
  <Style x:Key="Card" TargetType="Border"><Setter Property="local:CardMotion.Enabled" Value="True"/><Setter Property="Background" Value="{StaticResource GreenCardBrush}"/><Setter Property="BorderBrush" Value="{StaticResource GreenCardRim}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style TargetType="Button">
    <Setter Property="Cursor" Value="{x:Static local:AppCursors.Hand}"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="18,0"/><Setter Property="Foreground" Value="#F4F6FA"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="{StaticResource Frosted}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="#505A7C" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A5B4FC"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#B8C8FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Cursor" Value="IBeam"/><Setter Property="Background" Value="#0F1118"/><Setter Property="Foreground" Value="#F4F6FA"/><Setter Property="CaretBrush" Value="#F4F6FA"/><Setter Property="BorderBrush" Value="#2D3142"/><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="38"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Cursor" Value="IBeam"/><Setter Property="Background" Value="#0F1118"/><Setter Property="Foreground" Value="#F4F6FA"/><Setter Property="CaretBrush" Value="#F4F6FA"/><Setter Property="BorderBrush" Value="#2D3142"/><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="40"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F4F6FA"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="18" Height="18" Background="#11131B" BorderBrush="#555E77" BorderThickness="1" CornerRadius="5" Margin="0,0,9,0"><Path x:Name="Tick" Data="M 2,6.5 L 5.2,9.5 L 11,3" Stroke="#F4F6FA" StrokeThickness="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#526BCC"/><Setter TargetName="Box" Property="BorderBrush" Value="#A5B4FC"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F4F6FA"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#242838"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource GreenCardBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox">
    <Setter Property="Cursor" Value="{x:Static local:AppCursors.Hand}"/><Setter Property="local:ComboGlow.Enabled" Value="True"/><Setter Property="Height" Value="44"/><Setter Property="Foreground" Value="#F4F6FA"/><Setter Property="FontSize" Value="13.5"/><Setter Property="MaxDropDownHeight" Value="300"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform x:Name="Scale"/></Grid.RenderTransform>
        <Border CornerRadius="12" BorderThickness="2" BorderBrush="#5B7BFF" Opacity="0.18" IsHitTestVisible="False"><Border.Effect><BlurEffect Radius="14"/></Border.Effect></Border>
        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{StaticResource Frosted}" BorderBrush="#2D3142" BorderThickness="1" CornerRadius="12"><Grid><Border Height="1" VerticalAlignment="Top" Margin="12,0" Background="#14FFFFFF"/><Path x:Name="Chevron" Data="M 1,1 L 5.5,5.5 L 10,1" Stroke="#B8C4E0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform x:Name="Arrow"/></Path.RenderTransform></Path></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
        <Border x:Name="Bloom" CornerRadius="12" BorderThickness="2.5" Opacity="0" IsHitTestVisible="False"><Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><LinearGradientBrush.RelativeTransform><RotateTransform x:Name="BloomRotate" CenterX="0.5" CenterY="0.5"/></LinearGradientBrush.RelativeTransform><GradientStop Color="#005B7BFF"/><GradientStop Color="#BB7C9BFF" Offset="0.44"/><GradientStop Color="White" Offset="0.5"/><GradientStop Color="#BB7C9BFF" Offset="0.56"/><GradientStop Color="#005B7BFF" Offset="1"/></LinearGradientBrush></Border.BorderBrush><Border.Effect><BlurEffect Radius="14"/></Border.Effect></Border>
        <Border x:Name="Rim" CornerRadius="12" BorderThickness="1.5" Opacity="0" IsHitTestVisible="False"><Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><LinearGradientBrush.RelativeTransform><RotateTransform x:Name="RimRotate" CenterX="0.5" CenterY="0.5"/></LinearGradientBrush.RelativeTransform><GradientStop Color="#00FFFFFF"/><GradientStop Color="#99A5B4FC" Offset="0.45"/><GradientStop Color="White" Offset="0.5"/><GradientStop Color="#99A5B4FC" Offset="0.55"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.BorderBrush></Border>
        <ContentPresenter Margin="14,0,36,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="6" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="#14161E" BorderBrush="#6D7CAF" BorderThickness="1" CornerRadius="12" Padding="4"><Border.Effect><DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="5" Opacity="0.65"/></Border.Effect><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bloom" Property="Opacity" Value="0.95"/><Setter TargetName="Rim" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Bloom" Property="Opacity" Value="0.95"/><Setter TargetName="Rim" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Bloom" Property="Opacity" Value="0.95"/><Setter TargetName="Rim" Property="Opacity" Value="1"/></Trigger>
        <Trigger SourceName="Toggle" Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.88"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border HorizontalAlignment="Left" Background="#090A0E" BorderBrush="#2A2D3A" BorderThickness="1" CornerRadius="12" Padding="4"><TabPanel IsItemsHost="True"/></Border><ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem"><Setter Property="Cursor" Value="{x:Static local:AppCursors.Hand}"/><Setter Property="Foreground" Value="#9CA3B5"/><Setter Property="Padding" Value="16,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{StaticResource GreenCardBrush}"/><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource GreenCardRim}"/><Setter TargetName="Tab" Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#F4F6FA"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#A5B4FC"/><Setter TargetName="Tab" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <!-- The thumb retains standard ScrollBar commands and keyboard behavior. -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="12"/><Setter Property="MinWidth" Value="12"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Grid Background="#22000000"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Maximum="{TemplateBinding Maximum}" Minimum="{TemplateBinding Minimum}" ViewportSize="{TemplateBinding ViewportSize}">
        <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbSurface" Margin="3,2" CornerRadius="5" Background="{StaticResource GreenCardBrush}" BorderBrush="{StaticResource GreenCardRim}" BorderThickness="1" local:CardMotion.Enabled="True" Opacity="0.7"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
      </Track></Grid>
      <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="12"/><Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/></Trigger></Style.Triggers>
  </Style>
</ResourceDictionary>
