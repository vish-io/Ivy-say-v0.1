<Window x:Class="IvySay.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ivy Say" Width="285" Height="64" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="True" ShowActivated="False" ResizeMode="NoResize">
    <Border Background="#182e29" CornerRadius="32" BorderBrush="#405c50" BorderThickness="1" MouseLeftButtonDown="DragPill">
        <Grid Margin="9,7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
            <Border Background="#b8efb1" CornerRadius="23" Width="40" Height="40"><TextBlock Text="✦" Foreground="#18382d" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusTitle" Text="Ready to listen" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusDetail" Text="Ctrl + Win + Space" Foreground="#a9c1b4" FontSize="10" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" Content="⚙" ToolTip="Settings" Click="OpenSettings" Background="#2d4940" FontSize="17" Padding="0" Width="38" Height="38"/>
        </Grid>
    </Border>
</Window>
