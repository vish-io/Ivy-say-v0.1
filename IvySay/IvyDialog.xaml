<Window x:Class="IvySay.IvyDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ivy Say" Icon="/IvySay;component/IvySay.ico" Width="440" SizeToContent="Height" MinHeight="190" MaxHeight="600" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Background="#0F1015" Foreground="#F4F6FA" FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="NightGlowTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Border BorderBrush="{StaticResource GreenCardRim}" BorderThickness="1" CornerRadius="14" Background="{StaticResource GreenCardBrush}">
    <Grid Margin="22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><Border Width="32" Height="32" CornerRadius="9" Background="#1D2B24" BorderBrush="#395C4A" BorderThickness="1" Margin="0,0,10,0"><Path Data="M 12,2 L 14.5,9.5 L 22,12 L 14.5,14.5 L 12,22 L 9.5,14.5 L 2,12 L 9.5,9.5 Z" Fill="#A7F3C0" Width="15" Height="15" Stretch="Uniform"/></Border><TextBlock x:Name="Heading" Text="Ivy Say" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
        <Button Grid.Column="1" Content="×" Click="CloseClicked" Width="32" Height="32" Padding="0" Background="Transparent" FontSize="19" ToolTip="Close" AutomationProperties.Name="Close dialog"/>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="300" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock x:Name="Severity" Foreground="#F59E7A" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7" Visibility="Collapsed"/><TextBlock x:Name="Message" FontSize="14" LineHeight="21" Foreground="#F4F6FA" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
        <Button x:Name="NoButton" Content="No" Click="NoClicked" MinWidth="76" Margin="0,0,8,0" Background="#1A1D27" Visibility="Collapsed"/>
        <Button x:Name="YesButton" Content="Yes" Click="YesClicked" MinWidth="76" Visibility="Collapsed"/>
        <Button x:Name="OkButton" Content="OK" Click="OkClicked" MinWidth="76" Visibility="Collapsed"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
