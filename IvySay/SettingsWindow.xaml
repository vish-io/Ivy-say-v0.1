<Window Icon="/IvySay;component/IvySay.ico" x:Class="IvySay.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:IvySay" Cursor="{x:Static local:AppCursors.Arrow}" Title="Ivy Say · Settings" Width="760" Height="740" MinWidth="520" MinHeight="540" WindowStartupLocation="CenterScreen" Background="{DynamicResource SettingsBackdrop}" Foreground="#F4F6FA" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="NightGlowTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid><local:KineticGrid x:Name="KineticBackground"/>
  <Grid Margin="24,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Border Background="#1D2B24" BorderBrush="#395C4A" BorderThickness="1" CornerRadius="11" Width="40" Height="40"><Path Data="M 12,2 L 14.5,9.5 L 22,12 L 14.5,14.5 L 12,22 L 9.5,14.5 L 2,12 L 9.5,9.5 Z" Fill="#A7F3C0" Width="18" Height="18" Stretch="Uniform"/></Border><StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="ivy say" FontFamily="Georgia, Segoe UI" FontSize="17" FontWeight="Normal"/><TextBlock Text="Settings" FontSize="12" Foreground="#6B7285"/></StackPanel></StackPanel>
      <TextBlock Grid.Column="1" Text="Your voice, in flow." Foreground="#6B7285" VerticalAlignment="Center" FontSize="12"/>
    </Grid>
    <TabControl x:Name="SettingsTabs" SelectionChanged="SettingsTabChanged" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
      <TabItem Header="General"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="620" Margin="4,16,12,8">
        <TextBlock Text="Make Ivy Say yours" FontFamily="Georgia, Segoe UI" FontSize="27" FontWeight="Normal" Foreground="#F4F6FA"/>
        <TextBlock Text="Choose how you speak and type." Foreground="#9CA3B5" Margin="0,5,0,18"/>
        <Border x:Name="ConnectionCard" Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="Connect to Groq" Style="{StaticResource SectionTitle}"/>
          <TextBlock x:Name="KeyStatus" TextWrapping="Wrap" Foreground="#9CA3B5" FontSize="12" Margin="0,8,0,8"/>
          <Expander x:Name="KeySection" Header="Manage key" Foreground="#F4F6FA">
            <StackPanel Margin="0,10,0,0">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><PasswordBox x:Name="ApiKey" ToolTip="Groq API key"/><TextBox x:Name="VisibleApiKey" Visibility="Collapsed" ToolTip="Groq API key (visible)"/><Button x:Name="KeyVisibility" Grid.Column="1" Content="Show" Click="ToggleKeyVisibility" Margin="8,0,0,0"/></Grid>
              <WrapPanel Margin="0,10,0,0"><Button Content="Save key" Click="SaveKey"/><Button Content="Remove key" Click="RemoveKey" Background="#1A1D27" Foreground="#F4F6FA" Margin="8,0,0,0"/></WrapPanel>
            </StackPanel>
          </Expander>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="Your voice" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/>
          <TextBlock Text="Language you speak" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="SpokenLanguage" SelectedIndex="1"><ComboBoxItem Content="Detect automatically"/><ComboBoxItem Content="English"/><ComboBoxItem Content="Hindi"/><ComboBoxItem Content="Punjabi"/></ComboBox>
          <TextBlock Text="Microphone" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
          <ComboBox x:Name="Microphone" DisplayMemberPath="Label"/>
          <TextBlock Text="Keyboard shortcut" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
          <Button x:Name="ShortcutCapture" Click="CaptureShortcut" PreviewKeyDown="ShortcutKeyDown" LostKeyboardFocus="ShortcutCaptureLostFocus" HorizontalAlignment="Stretch" ToolTip="Click, then press your shortcut"/>
          <TextBlock Text="How to speak" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
          <ComboBox x:Name="ShortcutMode" SelectedIndex="0"><ComboBoxItem Content="Press once to start and again to finish"/><ComboBoxItem Content="Hold to speak, release to finish"/></ComboBox>
          <TextBlock Text="Choose a shortcut with a non-modifier key. In hold mode, Ivy Say consumes the chosen key while recording; modifier keys may still affect other apps. Windows may reserve some shortcuts." TextWrapping="Wrap" Foreground="#9CA3B5" FontSize="12" Margin="0,8,0,0"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
          <CheckBox x:Name="HidePillWhenIdle" Content="Hide the pill when not in use" Margin="0,0,0,8"/>
          <TextBlock Text="Use the Ivy Say icon in the Windows notification area to open Settings or quit." TextWrapping="Wrap" Foreground="#9CA3B5" FontSize="12" Margin="20,0,0,20"/>
          <TextBlock Text="Your text" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
          <CheckBox x:Name="Polish" Content="Make my words clear and polished" VerticalContentAlignment="Center"/>
          <TextBlock Text="How should Ivy Say insert text?" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/>
          <ComboBox x:Name="SecurityLevel" SelectedIndex="0" SelectionChanged="SecurityLevelChanged"><ComboBoxItem Content="Type automatically · no safety checks"/><ComboBoxItem Content="Type with safety checks · recommended"/><ComboBoxItem Content="Let me review and copy every time"/></ComboBox>
          <TextBlock x:Name="SecurityDescription" TextWrapping="Wrap" Foreground="#9CA3B5" FontSize="12" Margin="0,8,0,0"/>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="My words"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="620" Margin="4,16,12,8">
        <TextBlock Text="Make it sound like you" FontFamily="Georgia, Segoe UI" FontSize="27" FontWeight="Normal" Foreground="#F4F6FA"/>
        <TextBlock Text="Help Ivy Say recognize the words you use." Foreground="#9CA3B5" Margin="0,5,0,18" TextWrapping="Wrap"/>
        <Border x:Name="StatsCard" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="YOUR LAST 7 DAYS" Foreground="#9CA3B5" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="StatsValue" Text="— WPM" FontWeight="Light" FontSize="30" Foreground="#F4F6FA" Margin="0,6,0,2"/><TextBlock x:Name="StatsDetail" TextWrapping="Wrap" Foreground="#9CA3B5" FontSize="12"/></StackPanel><Button Grid.Column="1" Content="Clear stats" Click="ClearStats" Background="#252834" Foreground="#F4F6FA" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="Your personal words" Style="{StaticResource SectionTitle}"/>
          <CheckBox x:Name="UsePersonalization" Content="Use my words and corrections" Margin="0,16,0,0"/>
          <TextBlock Text="Select text in an app and press Ctrl + Alt + Win + D to add it. Some apps do not expose selections; the shortcut may conflict with another app." TextWrapping="Wrap" Foreground="#9CA3B5" FontSize="12" Margin="0,10,0,0"/>
          <TextBlock Text="Names and words · one per line" Style="{StaticResource FieldLabel}" Margin="0,20,0,7"/>
          <TextBox x:Name="Vocabulary" AcceptsReturn="True" MaxLength="1000" Height="100" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
          <TextBlock Text="Words to correct · one per line" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/>
          <TextBox x:Name="Corrections" AcceptsReturn="True" MaxLength="4500" Height="120" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" ToolTip="Example: grindel wald =&gt; Grindelwald"/>
          <TextBlock Text="Example: grindel wald =&gt; Grindelwald" TextWrapping="Wrap" Foreground="#9CA3B5" FontSize="12" Margin="0,8,0,0"/>
          <TextBlock Text="Your words are encrypted on this device. When enabled, relevant words and corrected text are sent to Groq. Don't add secrets." TextWrapping="Wrap" Foreground="#9CA3B5" FontSize="12" Margin="0,14,0,0"/>
          <WrapPanel Margin="0,16,0,0"><Button Content="Save words and snippets" Click="SavePersonalization"/><Button Content="Delete my words" Click="DeletePersonalization" Background="#1A1D27" Foreground="#F4F6FA" Margin="8,0,0,0"/></WrapPanel>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="Learn from corrections" Style="{StaticResource SectionTitle}"/>
          <CheckBox x:Name="LearnCorrections" Content="Learn words from my edits" Margin="0,16,0,0"/>
          <TextBlock Text="When enabled, Ivy Say briefly reads a small area around its recent insertion in supported text fields to detect spelling edits. Learned words are encrypted on this device and may be sent to Groq as hints. Password fields are excluded. This works only for some fields, not direct streaming or Quick Notes." TextWrapping="Wrap" Foreground="#9CA3B5" FontSize="12" Margin="0,10,0,0"/>
          <TextBlock Text="Learned words · remove any you don't want" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
          <TextBox x:Name="LearnedWords" AcceptsReturn="True" MaxLength="1000" Height="100" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
          <Button Content="Save learning settings and words" Click="SavePersonalization" HorizontalAlignment="Left" Margin="0,16,0,0"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="Snippets" Style="{StaticResource SectionTitle}"/>
          <CheckBox x:Name="UseSnippets" Content="Expand exact spoken phrases without AI formatting" Margin="0,16,0,0"/>
          <TextBlock Text="One per line: spoken phrase =&gt; text to insert" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
          <TextBox x:Name="Snippets" AcceptsReturn="True" MaxLength="10000" Height="100" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
          <TextBlock Text="Saved encrypted with your words. Matching snippets skip AI formatting but still use insertion safety checks." TextWrapping="Wrap" Foreground="#9CA3B5" FontSize="12" Margin="0,8,0,0"/>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Advanced"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="620" Margin="4,16,12,8">
        <TextBlock Text="Advanced settings" FontFamily="Georgia, Segoe UI" FontSize="27" FontWeight="Normal" Foreground="#F4F6FA"/>
        <TextBlock Text="Optional controls for speed, quality and testing." Foreground="#9CA3B5" Margin="0,5,0,18" TextWrapping="Wrap"/>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="Voice recognition" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
          <TextBlock Text="Recognition model" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="Model" SelectedIndex="1"><ComboBoxItem Content="More detailed · Whisper v3"/><ComboBoxItem Content="Faster · Whisper Turbo"/></ComboBox>
          <TextBlock Text="Audio compression · recordings of 8 seconds or more" Style="{StaticResource FieldLabel}" Margin="0,16,0,7" TextWrapping="Wrap"/>
          <ComboBox x:Name="Compression" SelectedIndex="1"><ComboBoxItem Content="Off · original audio"/><ComboBoxItem Content="Smaller audio · Opus 24 kbps"/><ComboBoxItem Content="Smaller audio · Opus 32 kbps"/><ComboBoxItem Content="Smaller audio · Opus 48 kbps"/></ComboBox>
          <CheckBox x:Name="EnableChunking" Content="Process long recordings while I speak" Margin="0,16,0,0"/>
          <TextBlock Text="When enabled, audio may be sent to Groq before you finish and may use extra requests." TextWrapping="Wrap" Foreground="#9CA3B5" FontSize="12" Margin="20,7,0,0"/>
          <TextBlock Text="Start after this many seconds (14–120)" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
          <TextBox x:Name="ChunkThreshold" MaxLength="3"/>
          <TextBlock Text="Spelling hints (optional)" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
          <TextBox x:Name="SpellingHints" MaxLength="160" ToolTip="Names and words to help recognition"/>
          <TextBlock Text="Stored without encryption and sent to Groq. Don't add secrets." TextWrapping="Wrap" Foreground="#9CA3B5" FontSize="12" Margin="0,7,0,0"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="Formatting &amp; speed" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
          <CheckBox x:Name="SmartFormatterRouting" Content="Choose the formatter automatically (experimental)"/>
          <TextBlock Text="May use a slower, more expensive model for longer speech or some English corrections." TextWrapping="Wrap" Foreground="#9CA3B5" FontSize="12" Margin="20,7,0,0"/>
          <TextBlock Text="Use the larger model at this many words (20–500)" Style="{StaticResource FieldLabel}" Margin="0,16,0,7" TextWrapping="Wrap"/>
          <TextBox x:Name="FormatterWordThreshold" MaxLength="3"/>
          <TextBlock Text="When to type" Style="{StaticResource FieldLabel}" Margin="0,16,0,7"/>
          <ComboBox x:Name="StreamingMode" SelectedIndex="0"><ComboBoxItem Content="Wait until the text is ready"/><ComboBoxItem Content="Type as words appear · no safety checks only"/></ComboBox>
          <TextBlock Text="Typing as words appear may leave partial text or trigger actions. Safety checks use the first option." TextWrapping="Wrap" Foreground="#9CA3B5" FontSize="12" Margin="0,7,0,0"/>
          <CheckBox x:Name="UseAppContext" Content="Adapt formatting to the active app" Margin="0,16,0,0"/>
          <TextBlock Text="Sends the app name to Groq with your text. No window title or screen content is sent." TextWrapping="Wrap" Foreground="#9CA3B5" FontSize="12" Margin="20,7,0,0"/>
          <CheckBox x:Name="StatusSounds" Content="Play listening, completion and error sounds" Margin="0,16,0,0"/>
          <CheckBox x:Name="QuickNotesEnabled" Content="Enable Quick Notes" Margin="0,16,0,0"/>
          <TextBlock Text="Ctrl + Alt + Win + N starts or stops a Quick Note. Notes are saved unencrypted in inbox.md in your chosen folder; audio and text are sent to Groq." TextWrapping="Wrap" Foreground="#9CA3B5" FontSize="12" Margin="20,7,0,0"/>
          <TextBox x:Name="QuickNotesFolder" IsReadOnly="True" Margin="0,8,0,0" ToolTip="Quick Notes folder"/>
          <Button Content="Choose notes folder" Click="ChooseNotesFolder" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          <CheckBox x:Name="ShowComparison" Content="Show transcription and formatting details" Margin="0,16,0,0" ToolTip="Shows text and allows local audio playback after insertion."/>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Your audio and text are sent to Groq." TextWrapping="Wrap" Foreground="#6B7285" FontSize="11" VerticalAlignment="Center"/>
      <Button x:Name="GeneralSettingsSave" Grid.Column="1" Content="Save settings" Click="SavePreferences" Margin="8,0,0,0"/>
      <Button Grid.Column="2" Content="Quit app" Click="Quit" Background="Transparent" Foreground="#9CA3B5" Margin="8,0,0,0"/>
      <Button Grid.Column="3" Content="Close" Click="CloseSettings" Background="#1A1D27" Foreground="#F4F6FA" Margin="8,0,0,0"/>
    </Grid>
  </Grid></Grid>
</Window>
