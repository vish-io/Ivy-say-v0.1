<Window x:Class="IvySay.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ivy Say · Settings" Width="560" Height="620" MinWidth="500" MinHeight="580" WindowStartupLocation="CenterScreen" Background="#f5f7f2" Foreground="#202a28" FontFamily="Segoe UI">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="42,36">
    <StackPanel Orientation="Horizontal"><Border Background="#c6f2bc" CornerRadius="10" Width="38" Height="38"><TextBlock Text="✦" Foreground="#1b4635" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="ivy say" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/></StackPanel>
    <TextBlock Text="Your voice, in flow." FontSize="30" FontWeight="SemiBold" Margin="0,30,0,7"/>
    <TextBlock Text="A little setup, then let your words do the work." Foreground="#65746c" FontSize="14" TextWrapping="Wrap"/>
    <Border Background="White" BorderBrush="#e2eae2" BorderThickness="1" CornerRadius="14" Margin="0,28,0,0" Padding="22"><StackPanel>
      <TextBlock Text="YOUR GROQ API KEY" Foreground="#638171" FontSize="10" FontWeight="Bold"/>
      <TextBlock Text="Bring your own key" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,4"/>
      <TextBlock x:Name="KeyStatus" TextWrapping="Wrap" Foreground="#687a70" FontSize="12" Margin="0,0,0,14"/>
      <PasswordBox x:Name="ApiKey" Padding="11" BorderBrush="#d6e2d7" FontSize="14" ToolTip="Groq API key"/>
      <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="Save key" Click="SaveKey"/><Button Content="Remove key" Click="RemoveKey" Background="#e8efe9" Foreground="#355246" Margin="10,0,0,0"/></StackPanel>
    </StackPanel></Border>
    <Border Background="White" BorderBrush="#e2eae2" BorderThickness="1" CornerRadius="14" Margin="0,18,0,0" Padding="22"><StackPanel>
      <TextBlock Text="SPEED &amp; FORMATTING" Foreground="#638171" FontSize="10" FontWeight="Bold"/>
      <TextBlock Text="Transcription model" FontWeight="SemiBold" Margin="0,10,0,6"/>
      <ComboBox x:Name="Model" Padding="8" SelectedIndex="0"><ComboBoxItem Content="Whisper large v3 · quality"/><ComboBoxItem Content="Whisper large v3 turbo · faster"/></ComboBox>
      <TextBlock Text="Microphone" FontWeight="SemiBold" Margin="0,16,0,6"/>
      <ComboBox x:Name="Microphone" Padding="8" DisplayMemberPath="Label"/>
      <TextBlock Text="Choose the device you speak into, or use the Windows default." Foreground="#687a70" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/>
      <TextBlock Text="Global shortcut" FontWeight="SemiBold" Margin="0,16,0,6"/>
      <ComboBox x:Name="Shortcut" Padding="8" SelectedIndex="0"><ComboBoxItem Content="Ctrl + Win + Space"/><ComboBoxItem Content="Ctrl + Shift + Space"/><ComboBoxItem Content="Alt + Shift + Space"/></ComboBox>
      <TextBlock Text="Restart Ivy Say to apply a shortcut change." Foreground="#687a70" FontSize="12" Margin="0,7,0,0"/>
      <CheckBox x:Name="Polish" Content="Polish text with AI (enables spoken modes)" Margin="0,14,0,0"/>
      <CheckBox x:Name="ShowComparison" Content="Show transcription and AI comparison after insertion" Margin="0,14,0,0"/>
      <TextBlock Text="For testing: shows your dictation on screen until closed; it is not saved." TextWrapping="Wrap" Foreground="#687a70" FontSize="12" Margin="0,7,0,0"/>
      <TextBlock Text="Turning off polish skips a network request and inserts the raw transcript." TextWrapping="Wrap" Foreground="#687a70" FontSize="12" Margin="0,7,0,0"/>
      <Button Content="Save preferences" Click="SavePreferences" HorizontalAlignment="Left" Margin="0,14,0,0"/>
    </StackPanel></Border>
    <Border Background="#e7f1e6" CornerRadius="12" Padding="18" Margin="0,18,0,0"><StackPanel><TextBlock Text="HOW TO DICTATE" FontWeight="Bold" FontSize="10" Foreground="#5a7b67"/><TextBlock Text="Focus any text field. Press your shortcut to start, then press it again to finish." TextWrapping="Wrap" Margin="0,8,0,0" FontSize="13"/><TextBlock Text="Try starting with Code, Email, or Bullet to switch formats." TextWrapping="Wrap" Margin="0,7,0,0" Foreground="#63796b" FontSize="12"/></StackPanel></Border>
    <TextBlock Text="Your key is encrypted for this Windows account. Audio and text are sent to Groq for processing." TextWrapping="Wrap" Foreground="#7a8c80" FontSize="11" Margin="0,18,0,0"/>
    <Button Content="Quit Ivy Say" Click="Quit" Background="Transparent" Foreground="#677b6e" HorizontalAlignment="Left" Padding="0,14"/>
  </StackPanel></ScrollViewer>
</Window>
