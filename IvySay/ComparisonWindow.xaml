<Window Icon="/IvySay;component/IvySay.ico" x:Class="IvySay.ComparisonWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:IvySay" Cursor="{x:Static local:AppCursors.Arrow}" Title="Ivy Say · Pipeline comparison" Width="650" Height="700" MinWidth="500" MinHeight="520" WindowStartupLocation="CenterScreen" Background="#f5f7f2" FontFamily="Segoe UI">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Your dictation pipeline" FontSize="23" FontWeight="SemiBold" Foreground="#202a28"/>
    <TextBlock x:Name="Summary" Grid.Row="1" TextWrapping="Wrap" Foreground="#65746c" Margin="0,8,0,14"/>
    <TextBlock Grid.Row="2" Text="1 · Whisper transcript" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <TextBox x:Name="RawText" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" FontSize="14"/>
    <TextBlock x:Name="PersonalLabel" Grid.Row="4" FontWeight="SemiBold" Margin="0,14,0,6"/>
    <TextBox x:Name="PersonalText" Grid.Row="5" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" FontSize="14"/>
    <TextBlock x:Name="OutputLabel" Grid.Row="6" FontWeight="SemiBold" Margin="0,14,0,6"/>
    <TextBox x:Name="OutputText" Grid.Row="7" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" FontSize="14"/>
    <StackPanel Grid.Row="8" Margin="0,12,0,0">
      <Expander x:Name="RejectedDrafts" Header="View rejected drafts (not inserted)" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="These untrusted drafts were rejected, not inserted or saved in history. Review carefully." TextWrapping="Wrap" Margin="0,6,0,4"/>
          <TextBlock Text="First draft" FontWeight="SemiBold"/>
          <TextBox x:Name="FirstRejected" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="80"/>
          <TextBlock Text="Retry draft" FontWeight="SemiBold" Margin="0,6,0,0"/>
          <TextBox x:Name="RetryRejected" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="80"/>
        </StackPanel>
      </Expander>
      <TextBlock Text="Playback uses your speakers. This window keeps audio in memory until closed; optional encrypted history can save it if enabled." TextWrapping="Wrap" Foreground="#65746c"/>
    </StackPanel>
    <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,14,0,0">
      <Button Content="Play captured audio" Click="PlayAudio"/>
      <Button Content="Stop playback" Click="StopAudio" Margin="8,0,0,0"/>
      <Button Content="Close" Click="CloseWindow" Margin="8,0,0,0"/>
    </StackPanel>
  </Grid>
</Window>
