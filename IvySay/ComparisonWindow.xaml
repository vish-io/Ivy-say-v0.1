<Window x:Class="IvySay.ComparisonWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ivy Say · Pipeline comparison" Width="650" Height="600" MinWidth="500" MinHeight="460" WindowStartupLocation="CenterScreen" Background="#f5f7f2" FontFamily="Segoe UI">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Your dictation pipeline" FontSize="23" FontWeight="SemiBold" Foreground="#202a28"/>
    <TextBlock x:Name="Summary" Grid.Row="1" TextWrapping="Wrap" Foreground="#65746c" Margin="0,8,0,14"/>
    <TextBlock Grid.Row="2" Text="1 · Whisper transcript" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <TextBox x:Name="RawText" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" FontSize="14"/>
    <TextBlock x:Name="OutputLabel" Grid.Row="4" FontWeight="SemiBold" Margin="0,14,0,6"/>
    <TextBox x:Name="OutputText" Grid.Row="5" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" FontSize="14"/>
    <TextBlock Grid.Row="6" Text="Shown for testing only. Ivy Say does not save these texts; close this window to remove them from view." TextWrapping="Wrap" Foreground="#65746c" Margin="0,12,0,0"/>
    <Button Grid.Row="7" Content="Close" Click="CloseWindow" HorizontalAlignment="Left" Margin="0,14,0,0"/>
  </Grid>
</Window>
